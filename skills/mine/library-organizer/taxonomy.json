      "jd_code": "69",
      "path": "60-69 Library & Literature/69 Reading Lists & Summaries",
      "rules": {
        "title_keywords": [
          "reading list", "book summary", "book notes", "key takeaways", "synopsis",
          "executive summary", "course syllabus", "transcript"
