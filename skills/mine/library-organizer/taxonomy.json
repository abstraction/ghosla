        "content_keywords": [
          "muscle hypertrophy", "skeletal muscle", "joint mobility", "periodization",
          "progressive overload", "macronutrient", "caloric intake", "biomechanical"
        ],
        "regex_patterns": [
          "\\b(hamstrings|shoulders|spine|calisthenics|physique|vo2 max|mobility guide)\\b"
