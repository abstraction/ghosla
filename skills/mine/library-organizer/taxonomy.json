{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "2.0.0",
  "name": "Johnny.Decimal Master Library Taxonomy",
  "master_library_root": "60-69 Library & Literature",
  "system_folders": {
    "inbox": "00-09 System & Inbox/01 Intake & Inbox",
    "duplicates": "_recycle_bin/staged_duplicates",
    "staging": "60-69 Library & Literature/60 Meta, Staging & Ingestion"
  },
  "format_policy": {
    "handling": "co_locate",
    "supported_extensions": [".pdf", ".epub", ".mobi", ".djvu", ".cbr", ".cbz", ".azw3"]
  },
  "gatekeeper_exclusions": {
    "keywords": [
      "aadhaar", "passport", "pan card", "voter id", "driving license",
      "invoice", "receipt", "billing", "tax return", "itr-v", "form 16",
      "bank statement", "salary slip", "payslip", "boarding pass", "flight ticket",
      "blood test", "lipid profile", "cbc report", "prescription"
    ],
    "destination": "00-09 System & Inbox/01 Intake & Inbox",
    "reason": "Administrative, legal, personal identity, or active health tracker - excluded from master library."
  },
  "categories": [
    {
      "id": "61_COMPUTER_SCIENCE",
      "jd_code": "61",
      "path": "60-69 Library & Literature/61 Computer Science & Technical Systems",
      "rules": {
        "title_keywords": [
          "python", "javascript", "typescript", "golang", "rust", "linux", "kernel",
          "operating systems", "algorithms", "data structures", "leetcode", "compiler",
          "networking", "distributed systems", "database", "sql", "git", "clean code",
          "refactoring", "software engineering", "computer science", "system design",
          "cybersecurity", "docker", "kubernetes", "programming", "coding interview",
          "cracking the coding interview", "elements of programming interviews"
        ],
        "content_keywords": [
          "algorithm", "data structure", "source code", "function", "class", "compiler",
          "memory management", "concurrency", "runtime", "tcp/ip", "api design"
        ],
        "regex_patterns": [
          "\\b(dsa|leetcode|posix|unix|c\\+\\+|golang|react|vue|devops)\\b"
        ],
        "min_score": 10
      }
    },
    {
      "id": "62_ECONOMICS_WEALTH_MARKETS",
      "jd_code": "62",
      "path": "60-69 Library & Literature/62 Economics, Wealth & Markets",
      "rules": {
        "title_keywords": [
          "economics", "investing", "finance", "trading", "stock market", "macroeconomics",
          "microeconomics", "wealth", "capital", "monetary policy", "central banking",
          "portfolio", "valuation", "zerodha varsity", "technical analysis", "fundamental analysis",
          "adam smith", "wealth of nations", "arbitrage", "derivatives", "smart money",
          "ict mentorship", "market structure"
        ],
        "content_keywords": [
          "financial market", "asset allocation", "liquidity", "inflation", "gdp",
          "yield curve", "interest rate", "equity", "balance sheet"
        ],
        "regex_patterns": [
          "\\b(vwap|candlestick|ict mentorship|order block|forex|options trading)\\b"
        ],
        "min_score": 10
      }
    },
    {
      "id": "63_PHYSICAL_CULTURE_HEALTH_PHYSIOLOGY",
      "jd_code": "63",
      "path": "60-69 Library & Literature/63 Physical Culture, Health & Physiology",
      "rules": {
        "title_keywords": [
          "hypertrophy", "biomechanics", "stretching", "mobility", "strength training",
